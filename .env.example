# Public URL used in password-reset links
PUBLIC_APP_URL=https://your-vaultora-domain.example

# SMTP provider configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Vaultora <no-reply@your-domain.example>
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_REPLY_TO=support@your-domain.example
SMTP_FROM_NAME=Vaultora

# Branded email template configuration
EMAIL_PLATFORM_NAME=Vaultora
EMAIL_LOGO_URL=https://your-domain.example/vaultora-mark.svg
